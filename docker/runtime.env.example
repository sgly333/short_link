# 复制为 runtime.env 后按需修改
#
# admin / project / gateway 均依赖 application-docker.yaml（compose 已写 SPRING_PROFILES_ACTIVE），
# 重新打包对应模块使 yaml 打进 jar；否则会连 127.0.0.1，导致 Nacos 无实例或网关不可用。

REDIS_PASSWORD=123456

NACOS_ADDR=nacos:8848
ROCKETMQ_NAMESRV=rocketmq-namesrv:9876
SHORT_LINK_DOMAIN_DEFAULT=47.99.78.39:8001

GATEWAY_PORT=8000
ADMIN_PORT=8002
PROJECT_PORT=8001

# 8G 机器建议值（按实际负载可再调）
JAVA_TOOL_OPTIONS=-Xms512m -Xmx1024m
